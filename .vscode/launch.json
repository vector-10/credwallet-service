{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "runtimeExecutable": "ts-node",
            "program": "${workspaceFolder}/src/server.ts",
            "sourceMaps": true,
            "env": {
                "NODE_ENV": "development"
            }
        }
    ]
}